# Generate two independent long random values. If either contains URI-reserved characters,
# percent-encode it in the matching DSN or inject the complete DSN from a secret manager.
POSTGRES_DB=agentbarrier
AGENTBARRIER_MIGRATION_DB_USER=agentbarrier_migrator
AGENTBARRIER_MIGRATION_DB_PASSWORD=replace-with-migration-secret
AGENTBARRIER_MIGRATION_POSTGRES_DSN=postgresql://agentbarrier_migrator:replace-with-migration-secret@postgres:5432/agentbarrier
AGENTBARRIER_RUNTIME_DB_USER=agentbarrier_runtime
AGENTBARRIER_RUNTIME_DB_PASSWORD=replace-with-runtime-secret
AGENTBARRIER_RUNTIME_POSTGRES_DSN=postgresql://agentbarrier_runtime:replace-with-runtime-secret@postgres:5432/agentbarrier

# Use an immutable source revision or release identifier in shared environments.
AGENTBARRIER_IMAGE_TAG=local
